{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": false,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "preserve",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "paths": {
      "@rusty-roguelike/feature-game": ["libs/feature-game/src/index.ts"],
      "@rusty-roguelike/platform": ["libs/platform/src/index.ts"],
      "@rusty-roguelike/protocol": ["libs/protocol/src/index.ts"],
      "@rusty-roguelike/store": ["libs/store/src/index.ts"],
      "@rusty-roguelike/theme": ["libs/theme/src/index.ts"],
      "@rusty-roguelike/transport": ["libs/transport/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "dist", "coverage"]
}
