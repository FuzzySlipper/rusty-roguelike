{
  "name": "rusty-roguelike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "nx run-many -t build --all",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check:dependency-adversaries": "node --test tools/check-dependency-sources.test.mjs",
    "check:dependencies": "node tools/check-dependency-sources.mjs",
    "dev": "pnpm run serve:local",
    "e2e": "pnpm run build && nx e2e app-e2e",
    "format:check": "prettier --check .",
    "lint": "nx run-many -t lint --all",
    "protocol:check": "cargo run --manifest-path rust/Cargo.toml -p rusty-roguelike --bin rusty-roguelike-protocol -- --check libs/protocol/src/generated/api-types.ts",
    "protocol:generate": "cargo run --manifest-path rust/Cargo.toml -p rusty-roguelike --bin rusty-roguelike-protocol -- libs/protocol/src/generated/api-types.ts",
    "serve:local": "node tools/serve-local.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "nx run-many -t typecheck --all",
    "verify": "./scripts/verify.sh",
    "verify:boundaries": "pnpm run check:dependencies && pnpm run check:dependency-adversaries && pnpm run check:boundaries && pnpm run protocol:check",
    "verify:browser": "pnpm run e2e",
    "verify:build": "pnpm run build",
    "verify:rust": "cargo fmt --manifest-path rust/Cargo.toml --check && cargo test --manifest-path rust/Cargo.toml --workspace --locked && cargo clippy --manifest-path rust/Cargo.toml --workspace --all-targets --locked -- -D warnings",
    "verify:ui": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test"
  },
  "dependencies": {
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@rusty-engine/render-contracts": "github:FuzzySlipper/rusty-engine#b1f0415af6266783246371d227a2272de7d9f0d6&path:render/packages/render-contracts",
    "@rusty-engine/render-projection": "github:FuzzySlipper/rusty-engine#b1f0415af6266783246371d227a2272de7d9f0d6&path:render/packages/render-projection",
    "@rusty-engine/renderer-host": "github:FuzzySlipper/rusty-engine#b1f0415af6266783246371d227a2272de7d9f0d6&path:render/packages/renderer-host",
    "@rusty-engine/renderer-three": "github:FuzzySlipper/rusty-engine#b1f0415af6266783246371d227a2272de7d9f0d6&path:render/packages/renderer-three",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@eslint/js": "^9.39.4",
    "@nx/angular": "23.0.1",
    "@nx/devkit": "23.0.1",
    "@nx/eslint": "23.0.1",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/js": "23.0.1",
    "@nx/playwright": "23.0.1",
    "@nx/web": "23.0.1",
    "@nx/workspace": "23.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.12.0",
    "@typescript-eslint/utils": "^8.61.1",
    "angular-eslint": "^21.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.4.0",
    "nx": "23.0.1",
    "prettier": "~3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  }
}
