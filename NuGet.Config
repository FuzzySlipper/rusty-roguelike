<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Provision this directory with the immutable SDK paired with the
         installed .runtime/runtime-pack; it is never an Engine source tree. -->
    <add key="rusty-engine-local" value=".runtime/sdk-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
