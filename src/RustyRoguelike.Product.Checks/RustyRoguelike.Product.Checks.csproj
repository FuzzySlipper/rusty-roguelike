<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RustyRoguelike.Product/RustyRoguelike.Product.csproj" />
    <PackageReference Include="Rusty.Engine" Version="$(RustyEnginePackageVersion)">
      <ExcludeAssets Condition="'$(RustyEngineUseSourceDevelopment)' == 'true'">compile;runtime</ExcludeAssets>
    </PackageReference>
    <Content Include="../../content/floors/starter-floor.5201.procgen.json"
             Link="content/starter-floor.5201.procgen.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
