<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RustyEngineSdkPackageVersion>0.1.0-dev.cabba0f</RustyEngineSdkPackageVersion>
    <RustyEngineProductEntryType>RustyRoguelike.NavigationAtomicityProbe.NavigationAtomicityProbeProduct</RustyEngineProductEntryType>
    <RustyEngineProductId>rusty-roguelike.navigation-atomicity</RustyEngineProductId>
    <RustyEngineProductTitle>Rusty Roguelike navigation atomicity probe</RustyEngineProductTitle>
    <RustyEngineProductUiRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../ui'))</RustyEngineProductUiRoot>
    <RustyEngineProductContentRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../content'))</RustyEngineProductContentRoot>
    <RustyEngineProductUiEntry>main.js</RustyEngineProductUiEntry>
    <RustyEngineProductUiProjectionStream>rusty-roguelike.navigation-atomicity</RustyEngineProductUiProjectionStream>
    <RustyEngineProductUiProjectionContract>rusty-roguelike.navigation-atomicity.v1</RustyEngineProductUiProjectionContract>
    <RustyEngineProductLifecycleMode>demand</RustyEngineProductLifecycleMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../RustyRoguelike.Product/RustyRoguelike.Product.csproj" />
    <PackageReference Include="Rusty.Engine" Version="$(RustyEngineSdkPackageVersion)">
      <ExcludeAssets Condition="'$(RustyEngineUseSourceDevelopment)' == 'true'">compile;runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
